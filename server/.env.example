# Copy this file to .env for local development:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets, API keys, or tokens.
# In upper environments (staging/production/containers), set these as
# real environment variables via your platform/orchestrator secret
# store instead of shipping a .env file.

# development | test | production
NODE_ENV=development

# Port the Express server listens on.
PORT=3001

# Comma-separated list of origins allowed to make cross-origin requests
# to this API (OWASP: never use a wildcard "*" origin for APIs that
# accept credentials or serve sensitive data). Required when
# NODE_ENV=production; defaults to the local Vite dev server origin
# otherwise.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to "true" only when a real reverse proxy sits in front of this
# app (e.g. in a container behind a load balancer) and correctly
# overwrites X-Forwarded-* headers. Leave unset/false otherwise —
# trusting it without a real proxy lets clients spoof their IP and
# bypass rate limiting.
TRUST_PROXY=false

# Rate limiting (basic brute-force / abuse mitigation).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Optional database feature (PostgreSQL via Prisma). The app runs fine
# with this left at its default (false) — no database is required.
# Set to "true" and provide DATABASE_URL to enable the sample
# /api/notes routes. For native local dev against the docker-compose
# "db" service (`docker compose --profile db up -d`, port-mapped to
# 127.0.0.1:5432), a working DATABASE_URL looks like:
#   postgresql://app:CHANGEME@localhost:5432/app
# (URL-encode the password yourself here if it contains characters
# like @, :, /, #, or % — this file is the source of truth for a
# natively-running server, unlike the containerized server, which
# derives and encodes DATABASE_URL automatically from discrete
# POSTGRES_USER/PASSWORD/DB variables; see root .env.example.)
#
# NOTE: when running the server itself via docker-compose.yml, this
# value is controlled by the root .env file instead — the
# `environment:` block there takes precedence over this file's
# env_file values.
DATABASE_ENABLED=false
# DATABASE_URL=postgresql://app:CHANGEME@localhost:5432/app
