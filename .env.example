# Copy this file to .env for local Docker Compose use:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets. These values are read
# by docker-compose.yml for the optional "db" service (Postgres),
# started only with `docker compose --profile db up -d`.
#
# This is intentionally separate from server/.env, which holds
# application-level runtime config/secrets (e.g. DATABASE_URL). This
# root .env only holds container-orchestration-level Postgres secrets.

# The postgres image itself refuses to start without a password, so
# leaving this unset causes the "db" service to fail fast — but only
# when it's actually started via `--profile db`, keeping the default
# `docker compose up` (no database) working with zero config.
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=app

# Set to "true" together with `docker compose --profile db up -d` to
# enable the server's sample /api/notes routes against the bundled
# Postgres container. Leave "false" (or unset) otherwise — the app
# runs fine with no database at all.
DATABASE_ENABLED=false
